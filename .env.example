# Copy to .env on the host. Never place this file in public/.
PORT=8931
HOST=127.0.0.1
# Set the exact HTTPS origin of the final public website behind the reverse proxy.
PUBLIC_ORIGIN=https://www.oktlogisticholland.com
# A verified sender domain and a Resend sending key are required.
RESEND_API_KEY=
MAIL_FROM=
# Only enable after the final privacy text and processor arrangements are ready.
PRIVACY_READY=false
# Optional. Blank means no analytics; with an ID, loading requires visitor opt-in.
GA4_ID=

# Required for online mail on Vercel: persistent random secret, at least 32 characters.
FORM_TOKEN_SECRET=
